    {
      "pageDisplayName": "General",
      "cursorFillMode": "topToBottom",
      "content": [
        { "text": "Input", "type": "header" },
        { "id": "bBlockSkyrimInput:Controls", "text": "Keep SkyDoom buttons from Skyrim", "type": "toggle", "help": "While SkyDoom is active, keys and buttons bound on the Controls page only control DOOM. For example, Fire no longer also swings your Skyrim weapon, 1-7 no longer equip favourites, and D-pad Left/Right no longer trigger Skyrim's own actions.", "valueOptions": { "sourceType": "ModSettingBool" } },

        { "text": "DOOM.WAD", "type": "header" },
        { "id": "sWadPath:General", "text": "DOOM.WAD location", "type": "input", "help": "Full path to your own DOOM.WAD, for non-Steam installs. Leave empty to find it in your Steam libraries automatically. Takes effect the next time Skyrim starts.", "valueOptions": { "sourceType": "ModSettingString" } }
      ]
    }
  ]
