        { "id": "iMeleeKey:Controls", "text": "Melee", "type": "keymap", "ignoreConflicts": true, "help": "Switch to the fist, or the chainsaw if you have it. Press again to alternate.", "valueOptions": { "sourceType": "ModSettingInt" } },
        { "id": "iPistolKey:Controls", "text": "Pistol", "type": "keymap", "ignoreConflicts": true, "help": "Switch to the pistol.", "valueOptions": { "sourceType": "ModSettingInt" } },
        { "id": "iShotgunKey:Controls", "text": "Shotgun", "type": "keymap", "ignoreConflicts": true, "help": "Switch to the shotgun.", "valueOptions": { "sourceType": "ModSettingInt" } },
        { "id": "iChaingunKey:Controls", "text": "Chaingun", "type": "keymap", "ignoreConflicts": true, "help": "Switch to the chaingun.", "valueOptions": { "sourceType": "ModSettingInt" } },
        { "id": "iRocketKey:Controls", "text": "Rocket launcher", "type": "keymap", "ignoreConflicts": true, "help": "Switch to the rocket launcher.", "valueOptions": { "sourceType": "ModSettingInt" } },
        { "id": "iPlasmaKey:Controls", "text": "Plasma rifle", "type": "keymap", "ignoreConflicts": true, "help": "Switch to the plasma rifle.", "valueOptions": { "sourceType": "ModSettingInt" } },
