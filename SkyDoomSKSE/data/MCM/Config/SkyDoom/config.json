        { "id": "iShotgunButton:Controls", "text": "Shotgun", "type": "keymap", "ignoreConflicts": true, "help": "Switch to the shotgun.", "valueOptions": { "sourceType": "ModSettingInt" } },
        { "id": "iChaingunButton:Controls", "text": "Chaingun", "type": "keymap", "ignoreConflicts": true, "help": "Switch to the chaingun.", "valueOptions": { "sourceType": "ModSettingInt" } },
        { "id": "iRocketButton:Controls", "text": "Rocket launcher", "type": "keymap", "ignoreConflicts": true, "help": "Switch to the rocket launcher.", "valueOptions": { "sourceType": "ModSettingInt" } },
        { "id": "iPlasmaButton:Controls", "text": "Plasma rifle", "type": "keymap", "ignoreConflicts": true, "help": "Switch to the plasma rifle.", "valueOptions": { "sourceType": "ModSettingInt" } },
